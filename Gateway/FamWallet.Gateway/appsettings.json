{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "campaign-service-route": {
        "ClusterId": "campaign-service-cluster",
        "Match": { "Path": "campaign/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "campaign-service-cluster": {
        "Destinations": {
          "server1": {
            "Address": "http://localhost:32774"
          }
        }
      }
    }
  }
}
